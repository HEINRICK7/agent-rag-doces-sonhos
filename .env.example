APP_NAME=agent-rag-doces-sonhos
APP_ENV=development
APP_DEBUG=true
API_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/app
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio-secret
MINIO_SECURE=false
MINIO_BUCKET=products
EXTERNAL_API_BASE_URL=http://localhost:3002
EXTERNAL_API_DOCKER_BASE_URL=http://host.docker.internal:3002
EXTERNAL_API_PRODUCTS_PATH=/products
EXTERNAL_API_AUTH_MODE=none
EXTERNAL_API_TOKEN=
EXTERNAL_API_API_KEY_HEADER=X-API-Key
EXTERNAL_API_TIMEOUT_SECONDS=10
EXTERNAL_API_RETRY_ATTEMPTS=3
EXTERNAL_API_RETRY_BACKOFF_SECONDS=0.25
EXTERNAL_API_MAX_RETRY_DELAY=5
EXTERNAL_API_PAGINATION_MODE=none
EXTERNAL_API_PAGE_SIZE=100
EXTERNAL_API_MAX_PAGES=1000
EXTERNAL_API_PAGE_PARAM=page
EXTERNAL_API_OFFSET_PARAM=offset
EXTERNAL_API_LIMIT_PARAM=limit
EXTERNAL_API_CURSOR_PARAM=cursor
EXTERNAL_API_ITEMS_KEY=items
EXTERNAL_API_HAS_MORE_KEY=has_more
EXTERNAL_API_NEXT_CURSOR_KEY=next_cursor
EXTERNAL_API_TOTAL_KEY=total
EXTERNAL_API_INFER_HAS_MORE_FROM_PAGE_SIZE=false
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
DOCS_ENABLED=true
API_PORT=8000
DB_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
